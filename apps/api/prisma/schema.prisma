// Anatomy catalog. The 3D meshes live in object storage; this schema only describes the
// hierarchy of anatomical terms and which asset bundle holds each mesh (ADR 0003, ADR 0004).
// Keep enums in sync with packages/shared/src/anatomy.ts.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BodySystem {
  skeletal
  muscular
  cardiovascular
  nervous
  lymphatic
  digestive
  respiratory
  urinary
  reproductive
  endocrine
  integumentary
}

enum BodyRegion {
  head
  neck
  thorax
  abdomen
  pelvis
  back
  upper_limb
  lower_limb
}

enum Laterality {
  left
  right
  midline
}

model Structure {
  id          String       @id @default(uuid())
  /// `ta2:<id>` or `za:<slug>`; shared by left/right siblings.
  termKey     String
  ta2Id       Int?
  /// Mesh name inside the GLB. Null for group nodes without geometry.
  meshId      String?      @unique
  nameLa      String
  nameEn      String
  nameEs      String
  system      BodySystem
  subsystem   String?
  region      BodyRegion?
  laterality  Laterality   @default(midline)
  description String?
  parentId    String?
  parent      Structure?   @relation("Hierarchy", fields: [parentId], references: [id])
  children    Structure[]  @relation("Hierarchy")
  assetId     String?
  asset       AssetBundle? @relation(fields: [assetId], references: [id])
  boundsMin   Float[]
  boundsMax   Float[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([termKey, laterality])
  @@index([system])
  @@index([region])
  @@index([parentId])
}

model AssetBundle {
  id         String      @id // e.g. "skeletal-v1"
  system     BodySystem
  url        String
  sizeBytes  Int
  meshCount  Int
  hash       String
  createdAt  DateTime    @default(now())
  structures Structure[]
}
