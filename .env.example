# Copy to .env (root is read by docker compose; apps read their own .env files)
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas

# Web (apps/web/.env.local, or the deployment environment). Read at request time, not at build.
# Comma-separated exact origins allowed to frame the atlas and to drive it over postMessage
# (docs/embedding.md, ADR 0006). Scheme + host (+ port) only: no wildcards, no paths.
# Empty or unset: same-origin framing only and the embed bridge stays silent.
# EMBED_ALLOWED_ORIGINS=https://campuswazo.com,https://staging.campuswazo.com
EMBED_ALLOWED_ORIGINS=
